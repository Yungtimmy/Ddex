# CLI only (`npm run read`, `npm run place`, `npm run bridge`).
# The chat signs with the connected browser wallet and never reads a private key.
# Copy this file to .env (gitignored) or export the variables in your shell.
# PRIVATE_KEY=0x
# KEY_PATH=.secrets/dreamdex_testnet_key

# Optional. `npm run bridge` sends this much STT from Shannon to Hideki. Default 2.
# AMOUNT=2

# Optional. `npm run place` uses this BTC bid, in human quote units. Default 50000.
# PRICE=50000
